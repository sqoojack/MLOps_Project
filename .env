# AWS 帳號與區域設定
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# SageMaker 執行角色 (需具備 S3 存取與 SageMaker 執行權限)
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/sagemaker_execution_role_recsys

# 資料與模型存放的 S3 Bucket
S3_BUCKET_NAME=your-s3-bucket-name

# MLflow Tracking Server URI (訓練容器內需連線至此紀錄 Metrics)
MLFLOW_TRACKING_URI=http://your-mlflow-server-url:5000
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db