# Location: infrastructure/docker/Dockerfile.airflow
# Sync with Python 3.12
FROM apache/airflow:2.8.1-python3.12

USER root
# Install git for DVC operations
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow
# Install pipeline dependencies (This will now find v1.24.4)
COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt